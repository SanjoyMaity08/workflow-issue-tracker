/* ------------------------------------------------------------------ *
   Workflow - dark, dense, keyboard-first issue tracker.
   One accent (indigo) carries interactive weight; status and priority
   colours are the only other hues, so colour always means something.
 * ------------------------------------------------------------------ */

:root {
  --bg: #101114;
  --bg-raised: #17181c;
  --bg-hover: #1d1f24;
  --bg-input: #1b1d22;
  --line: #24262c;
  --line-strong: #33363d;
  --text: #e9eaec;
  --text-dim: #9096a0;
  --text-faint: #6b7079;
  --accent: #5e6ad2;
  --accent-hover: #6b77e0;
  --danger: #d94a4a;
  --radius: 6px;
  --radius-lg: 10px;
  --sidebar-w: 232px;
  --topbar-h: 48px;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  height: 100%;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica,
    Arial, sans-serif;
  font-size: 13.5px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

h1,
h2,
h3 {
  margin: 0;
  font-weight: 600;
  letter-spacing: -0.01em;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
  cursor: pointer;
}

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  border-radius: 3px;
}

@media (prefers-reduced-motion: reduce) {
  * {
    transition: none !important;
    animation: none !important;
  }
}

/* --- shared bits ---------------------------------------------------- */

.brand-mark {
  width: 14px;
  height: 14px;
  border-radius: 4px;
  background: linear-gradient(135deg, var(--accent), #8b93e8);
  display: inline-block;
}

.team-badge {
  width: 18px;
  height: 18px;
  border-radius: 5px;
  display: inline-grid;
  place-items: center;
  font-size: 10px;
  font-weight: 700;
  color: #fff;
  flex: none;
}

.team-badge--sm {
  width: 15px;
  height: 15px;
  font-size: 9px;
  border-radius: 4px;
}

.avatar {
  border-radius: 50%;
  display: inline-grid;
  place-items: center;
  color: #fff;
  font-weight: 600;
  flex: none;
}

.label {
  border: 1px solid var(--line-strong);
  border-radius: 20px;
  padding: 1px 8px;
  font-size: 11px;
  color: var(--text-dim);
}

.btn {
  border: 1px solid transparent;
  border-radius: var(--radius);
  padding: 6px 12px;
  font-size: 13px;
  font-weight: 500;
  color: var(--text);
  background: var(--bg-hover);
  transition: background 0.12s ease;
}

.btn:hover {
  background: var(--line);
}

.btn--primary {
  background: var(--accent);
  color: #fff;
}

.btn--primary:hover {
  background: var(--accent-hover);
}

.btn--primary:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.btn--ghost {
  background: transparent;
  border-color: var(--line-strong);
  color: var(--text-dim);
}

.btn--ghost:hover {
  background: var(--bg-hover);
  color: var(--text);
}

.btn--danger {
  background: transparent;
  border-color: var(--line-strong);
  color: var(--danger);
}

.btn--danger:hover {
  background: rgba(217, 74, 74, 0.12);
}

.btn--sm {
  padding: 4px 10px;
  font-size: 12.5px;
}

.btn--block {
  width: 100%;
  justify-content: center;
  padding: 9px 12px;
}

.icon-btn {
  background: none;
  border: none;
  color: var(--text-dim);
  font-size: 18px;
  line-height: 1;
  padding: 2px 6px;
  border-radius: var(--radius);
}

.icon-btn:hover {
  background: var(--bg-hover);
  color: var(--text);
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 1px solid var(--line-strong);
  background: var(--bg-raised);
  color: var(--text);
  border-radius: var(--radius);
  padding: 4px 9px;
  font-size: 12.5px;
}

.chip:hover {
  background: var(--bg-hover);
}

.chip--static {
  cursor: default;
}

.form-error {
  color: #f08a8a;
  font-size: 12.5px;
  margin: 8px 0 0;
}

.empty {
  color: var(--text-faint);
  padding: 40px 24px;
  text-align: center;
}

.empty--full {
  display: grid;
  place-items: center;
  height: 100vh;
}

/* --- dropdown ------------------------------------------------------- */

.select {
  position: relative;
  display: inline-block;
}

.select-menu {
  position: absolute;
  z-index: 40;
  top: calc(100% + 4px);
  min-width: 180px;
  margin: 0;
  padding: 4px;
  list-style: none;
  background: var(--bg-raised);
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-lg);
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
  max-height: 260px;
  overflow-y: auto;
}

.select-menu--left {
  left: 0;
}

.select-menu--right {
  right: 0;
}

.select-menu button {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  border: none;
  background: none;
  color: var(--text);
  text-align: left;
  padding: 6px 8px;
  border-radius: var(--radius);
  font-size: 13px;
}

.select-menu button:hover {
  background: var(--bg-hover);
}

.select-menu button.is-selected {
  color: #fff;
  background: rgba(94, 106, 210, 0.22);
}

/* --- auth ----------------------------------------------------------- */

.auth {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
}

.auth__card {
  width: 100%;
  max-width: 370px;
  background: var(--bg-raised);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 30px 28px;
}

.auth__brand {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
  color: var(--text-dim);
}

.auth__heading {
  font-size: 20px;
  margin: 18px 0 22px;
  line-height: 1.3;
}

.field {
  display: block;
  margin-bottom: 14px;
}

.field span {
  display: block;
  color: var(--text-dim);
  font-size: 12.5px;
  margin-bottom: 5px;
}

.field input {
  width: 100%;
  background: var(--bg-input);
  border: 1px solid var(--line-strong);
  border-radius: var(--radius);
  color: var(--text);
  padding: 8px 10px;
  font-size: 13.5px;
}

.field input:focus {
  outline: none;
  border-color: var(--accent);
}

.auth__hint {
  color: var(--text-faint);
  font-size: 12px;
  margin: 16px 0 0;
  line-height: 1.55;
}

/* --- shell ---------------------------------------------------------- */

.shell {
  display: grid;
  grid-template-columns: var(--sidebar-w) 1fr;
  height: 100vh;
}

.sidebar {
  background: #0c0d10;
  border-right: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  padding: 14px 10px;
  overflow-y: auto;
}

.sidebar__brand {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
  padding: 4px 8px 14px;
}

.sidebar__section {
  color: var(--text-faint);
  font-size: 11.5px;
  padding: 16px 8px 6px;
}

.sidebar__nav {
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.sidebar__link {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 8px;
  border-radius: var(--radius);
  color: var(--text-dim);
  font-size: 13px;
}

.sidebar__link:hover {
  background: var(--bg-hover);
  color: var(--text);
}

.sidebar__link.active {
  background: var(--bg-hover);
  color: var(--text);
  font-weight: 500;
}

.sidebar__foot {
  margin-top: auto;
  padding-top: 14px;
  border-top: 1px solid var(--line);
  display: flex;
  align-items: center;
  gap: 8px;
}

.sidebar__user {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.sidebar__user strong {
  font-size: 12.5px;
  font-weight: 500;
}

.sidebar__user span {
  font-size: 11px;
  color: var(--text-faint);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shell__main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.topbar {
  height: var(--topbar-h);
  flex: none;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
}

.topbar__title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
}

.shell__content {
  flex: 1;
  overflow: auto;
  min-height: 0;
}

/* --- board ---------------------------------------------------------- */

.board {
  display: flex;
  gap: 12px;
  padding: 16px;
  align-items: flex-start;
  min-height: 100%;
}

.column {
  flex: 0 0 290px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.column__head {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 2px 4px;
}

.column__head h2 {
  font-size: 13px;
  font-weight: 500;
}

.column__count {
  color: var(--text-faint);
  font-size: 12px;
}

.column__body {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.column__empty {
  color: var(--text-faint);
  font-size: 12px;
  padding: 10px 4px;
  margin: 0;
}

.card {
  display: block;
  background: var(--bg-raised);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 10px 11px;
  transition: border-color 0.12s ease, background 0.12s ease;
}

.card:hover {
  background: var(--bg-hover);
  border-color: var(--line-strong);
}

.card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}

.card__id {
  color: var(--text-faint);
  font-size: 11.5px;
}

.card__title {
  display: flex;
  align-items: flex-start;
  gap: 7px;
  line-height: 1.4;
}

.card__title svg {
  margin-top: 3px;
  flex: none;
}

.card__meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 9px;
  flex-wrap: wrap;
}

.card__priority {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--text-dim);
  font-size: 11.5px;
}

/* --- issue form / modal --------------------------------------------- */

.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: grid;
  place-items: start center;
  padding-top: 12vh;
  z-index: 50;
}

.modal {
  width: min(620px, calc(100vw - 32px));
  background: var(--bg-raised);
  border: 1px solid var(--line-strong);
  border-radius: 12px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
}

.modal__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 12px;
  border-bottom: 1px solid var(--line);
}

.modal__title {
  font-size: 12.5px;
  color: var(--text-dim);
}

.issue-form {
  padding: 12px;
}

.issue-form--compact {
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-lg);
  background: var(--bg-raised);
  margin-bottom: 8px;
}

.issue-form__team {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 12px;
  color: var(--text-dim);
  margin-bottom: 8px;
}

.issue-form__title,
.issue-form__description {
  width: 100%;
  background: none;
  border: none;
  color: var(--text);
  padding: 2px 0;
  resize: vertical;
  font-family: inherit;
}

.issue-form__title {
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 4px;
}

.issue-form__description {
  font-size: 13.5px;
  color: var(--text-dim);
  margin-bottom: 10px;
}

.issue-form__title:focus,
.issue-form__description:focus {
  outline: none;
}

.issue-form__title::placeholder,
.issue-form__description::placeholder {
  color: var(--text-faint);
}

.issue-form__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
  border-top: 1px solid var(--line);
  padding-top: 10px;
}

.issue-form__chips {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.issue-form__actions {
  display: flex;
  gap: 6px;
  margin-left: auto;
}

/* --- detail --------------------------------------------------------- */

.detail {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 240px;
  gap: 28px;
  padding: 24px 28px;
  max-width: 1100px;
}

.detail__breadcrumb {
  display: flex;
  gap: 8px;
  color: var(--text-faint);
  font-size: 12px;
  margin-bottom: 10px;
}

.detail__breadcrumb a:hover {
  color: var(--text);
}

.detail__title {
  font-size: 22px;
  line-height: 1.3;
  margin-bottom: 10px;
}

.detail__description {
  color: var(--text-dim);
  margin: 0 0 24px;
  max-width: 68ch;
}

.detail__description.is-empty {
  color: var(--text-faint);
  font-style: italic;
}

.sub-issues,
.activity {
  border-top: 1px solid var(--line);
  padding-top: 16px;
  margin-bottom: 24px;
}

.sub-issues__head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}

.sub-issues__head h2,
.activity h2 {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-dim);
}

.counter {
  color: var(--text-faint);
  font-size: 12px;
}

.sub-issues__head .btn {
  margin-left: auto;
}

.sub-issues__list,
.activity__list,
.comments,
.rows {
  list-style: none;
  margin: 0;
  padding: 0;
}

.sub-issues__list a {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 8px 9px;
  border-radius: var(--radius);
  border: 1px solid transparent;
}

.sub-issues__list a:hover {
  background: var(--bg-hover);
  border-color: var(--line);
}

.sub-issues__id {
  color: var(--text-faint);
  font-size: 11.5px;
  flex: none;
}

.sub-issues__title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sub-issues__empty {
  color: var(--text-faint);
  font-size: 12.5px;
  padding: 6px 2px;
}

.activity h2 {
  margin-bottom: 12px;
}

.activity__list li {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 5px 0;
  color: var(--text-dim);
  font-size: 12.5px;
}

.activity__list strong {
  color: var(--text);
  font-weight: 500;
}

.activity__list time,
.comments time {
  color: var(--text-faint);
  font-size: 11.5px;
  margin-left: auto;
}

.comments li {
  display: flex;
  gap: 10px;
  padding: 12px 0;
  border-top: 1px solid var(--line);
}

.comments li > div {
  flex: 1;
  min-width: 0;
}

.comments__head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 3px;
}

.comments__head strong {
  font-size: 12.5px;
  font-weight: 500;
}

.comments p {
  margin: 0;
  color: var(--text-dim);
}

.comment-box {
  margin-top: 14px;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-lg);
  background: var(--bg-raised);
  padding: 10px;
}

.comment-box textarea {
  width: 100%;
  background: none;
  border: none;
  color: var(--text);
  resize: vertical;
  font-family: inherit;
  font-size: 13.5px;
}

.comment-box textarea:focus {
  outline: none;
}

.comment-box textarea::placeholder {
  color: var(--text-faint);
}

.comment-box .btn {
  display: block;
  margin-left: auto;
}

.detail__side {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding-top: 26px;
}

.detail__prop {
  display: flex;
  flex-direction: column;
  gap: 6px;
  align-items: flex-start;
}

.detail__label {
  color: var(--text-faint);
  font-size: 11.5px;
}

.detail__labels {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
}

/* --- list view ------------------------------------------------------ */

.list-page {
  padding: 18px 20px;
  max-width: 940px;
}

.search {
  width: 100%;
  background: var(--bg-input);
  border: 1px solid var(--line-strong);
  border-radius: var(--radius);
  color: var(--text);
  padding: 8px 11px;
  font-size: 13.5px;
  margin-bottom: 14px;
}

.search:focus {
  outline: none;
  border-color: var(--accent);
}

.row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 10px;
  border-bottom: 1px solid var(--line);
}

.row:hover {
  background: var(--bg-hover);
}

.row__id {
  color: var(--text-faint);
  font-size: 11.5px;
  width: 62px;
  flex: none;
}

.row__title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row__sub,
.row__status {
  color: var(--text-faint);
  font-size: 11.5px;
  flex: none;
}

/* --- narrow screens -------------------------------------------------- */

@media (max-width: 860px) {
  .shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    display: none;
  }

  .detail {
    grid-template-columns: 1fr;
    gap: 18px;
    padding: 18px;
  }

  .detail__side {
    padding-top: 0;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }

  .column {
    flex: 0 0 82vw;
  }
}
